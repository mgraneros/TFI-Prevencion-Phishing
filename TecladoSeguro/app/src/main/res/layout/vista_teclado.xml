<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingTop="8dp">

    <!-- Fila 1: Letras Superiores -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="4dp"
        tools:ignore="ButtonStyle">

        <android.widget.Button android:id="@+id/btnQ" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="Q" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnW" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="W" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnE" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="E" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnR" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="R" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnT" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="T" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnY" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="Y" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnU" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="U" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnI" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="I" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnO" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="O" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnP" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:padding="0dp" android:text="P" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
    </LinearLayout>

    <!-- Fila 2: Letras Medias -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="20dp"
        tools:ignore="ButtonStyle">

        <android.widget.Button android:id="@+id/btnA" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="A" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnS" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="S" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnD" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="D" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnF" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="F" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnG" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="G" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnH" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="H" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnJ" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="J" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnK" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="K" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnL" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:padding="0dp" android:text="L" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
    </LinearLayout>

    <!-- Fila 3: Letras Inferiores y Acciones Básicas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        tools:ignore="ButtonStyle">

        <ImageButton android:id="@+id/btnMayus" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1.5" android:layout_marginEnd="2dp" android:padding="0dp" android:src="@drawable/ic_mayus" android:background="@drawable/fondo_tecla_azul" android:scaleType="centerInside" />

        <android.widget.Button android:id="@+id/btnZ" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="Z" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnX" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="X" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnC" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="C" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnV" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="V" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnB" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="B" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnN" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="N" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnM" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="M" android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />

        <ImageButton android:id="@+id/btnBorrar" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1.5" android:padding="0dp" android:src="@drawable/ic_borrar" android:background="@drawable/fondo_tecla_azul" android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Fila 4: Espacio y Enter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="ButtonStyle">

        <android.widget.Button android:id="@+id/btnSimbolos" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1.5" android:layout_marginEnd="2dp" android:padding="0dp" android:text="\?123" android:textStyle="bold" android:textSize="18sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla_azul" />
        <android.widget.Button android:id="@+id/btnComa" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="," android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnEspacio" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="4" android:layout_marginEnd="2dp" android:padding="0dp" android:text="ESPACIO" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />
        <android.widget.Button android:id="@+id/btnPunto" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:padding="0dp" android:text="." android:textSize="22sp" android:textColor="#FFFFFF" android:background="@drawable/fondo_tecla" />

        <ImageButton android:id="@+id/btnEnter" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1.5" android:padding="0dp" android:src="@drawable/ic_enter" android:background="@drawable/fondo_tecla_azul" android:scaleType="centerInside" />
    </LinearLayout>

</LinearLayout>