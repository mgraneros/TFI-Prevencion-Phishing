<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1929"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teclado Seguro"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="-0.02"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Protección activa y alertas SMS"
            android:textSize="16sp"
            android:textColor="#8AA2B9"
            android:layout_marginBottom="32dp"/>

        <!-- Tarjeta Estado del Teclado -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEstadoTeclado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#132743"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvEstadoTeclado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ El teclado no está activado"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FF5252"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnActivarTeclado"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="1. HABILITAR TECLADO"
                    android:textColor="#06111C"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta Contactos -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#132743"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contactos de Emergencia"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginBottom="20dp"/>

                <!-- Campo Número Principal -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0A1929"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etNumeroPrincipal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Número Principal (Ej: 112406...)"
                        android:textColorHint="#5A718A"
                        android:textColor="#FFFFFF"
                        android:inputType="phone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="16sp"/>
                </androidx.cardview.widget.CardView>

                <!-- Campo Número Respaldo -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#0A1929">

                    <EditText
                        android:id="@+id/etNumeroRespaldo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="Número Respaldo (Opcional)"
                        android:textColorHint="#5A718A"
                        android:textColor="#FFFFFF"
                        android:inputType="phone"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="16sp"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta Tamaño -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#132743"
            android:layout_marginBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamaño del Teclado"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#00E676"
                    android:layout_marginBottom="16dp"/>

                <RadioGroup
                    android:id="@+id/rgTamanoTeclado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/rbNormal"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Normal (Estándar)"
                        android:textSize="16sp"
                        android:textColor="#D1E4F9"
                        android:buttonTint="#00E676"/>

                    <RadioButton
                        android:id="@+id/rbGrande"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Grande (+ Accesibilidad)"
                        android:textSize="16sp"
                        android:textColor="#D1E4F9"
                        android:buttonTint="#00E676"/>

                    <RadioButton
                        android:id="@+id/rbExtraGrande"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Extra Grande (Máxima Visión)"
                        android:textSize="16sp"
                        android:textColor="#D1E4F9"
                        android:buttonTint="#00E676"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón Guardar Tech -->
        <!-- El layout_marginBottom de 48dp despega el botón del borde inferior -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="48dp"
            android:text="GUARDAR CONFIGURACIÓN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#06111C"
            android:letterSpacing="0.05"
            app:backgroundTint="#00E676"
            app:rippleColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:elevation="8dp" />

    </LinearLayout>
</ScrollView>