<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1929">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true">

        <!-- Tamaño llevado al límite de la pantalla (500dp) -->
        <ImageView
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher_foreground"
            android:layout_marginBottom="0dp"/> <!-- Margen normalizado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teclado Seguro"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTECCIÓN ACTIVA"
            android:textSize="16sp"
            android:textColor="#00E676"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.15"/>
    </LinearLayout>

    <!-- Indicador de carga en la parte inferior -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:indeterminateTint="#00E676" />

</RelativeLayout>